---
import CustomButton from './CustomButton.astro'

const links = [
  { text: 'Startsida', href: '/' },
  { text: 'Tjänster', href: '/services' },
  { text: 'Om oss', href: '/about' },
  { text: 'Kontakt', href: '/contact' }
]

const current = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<header class="navbar">
  <div class="logo">
    <a href="/">
      <img
        src="/img/diamond-logo.webp"
        alt="Vimmerby Diamantverktyg logo"
        width="100"
        height="100"
      />
    </a>
  </div>
  <button
    class="menu-toggle"
    type="button"
    aria-label="Meny"
    aria-controls="site-nav"
    aria-expanded="false">&#9776;</button
  >
  <nav id="site-nav" aria-label="Huvudmeny">
    <ul>
      {
        links.map(({ text, href }) => (
          <li>
            <CustomButton
              text={text}
              href={href}
              aria-current={href === current ? 'page' : undefined}
            />
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="phone">070-2297636</div>
</header>

<script>
  // Mobile menu: toggle with the hamburger button, close on any click outside the header or on Escape.
  const header = document.querySelector<HTMLElement>('.navbar')
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle')
  const nav = header?.querySelector<HTMLElement>('nav')

  if (header && toggle && nav) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle('open', open)
      toggle.setAttribute('aria-expanded', String(open))
    }

    toggle.addEventListener('click', () => {
      setOpen(!nav.classList.contains('open'))
    })

    document.addEventListener('click', (event) => {
      if (nav.classList.contains('open') && !header.contains(event.target as Node)) {
        setOpen(false)
      }
    })

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && nav.classList.contains('open')) {
        setOpen(false)
        toggle.focus()
      }
    })
  }
</script>

<style>
  .navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: black;
    color: white;
    position: relative;
    z-index: 10;
    padding: 0 1rem;
  }

  .navbar::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -50px;
    width: 100%;
    height: 50px;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 1), rgba(0, 0, 0, 0));
    pointer-events: none;
    z-index: 5;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .logo img {
    height: 100px;
    width: auto;
  }

  .menu-toggle {
    display: none;
    font-size: 2rem;
    background: none;
    border: none;
    color: white;
    cursor: pointer;
  }

  nav {
    display: flex;
  }

  nav ul {
    list-style: none;
    display: flex;
    gap: 2rem;
    margin: 0;
    padding: 0;
  }

  .phone {
    font-size: 1.2rem;
  }

  @media (max-width: 768px) {
    .menu-toggle {
      display: block;
    }

    nav {
      position: absolute;
      top: 100%;
      left: 0;
      width: 100%;
      background: black;
      overflow: hidden;
      max-height: 0;
      /* visibility keeps the collapsed links out of the tab order; it flips after the closing animation */
      visibility: hidden;
      transition:
        max-height 0.4s ease-in-out,
        visibility 0s linear 0.4s;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    nav.open {
      max-height: 500px; /* Enough to reveal the content */
      visibility: visible;
      transition:
        max-height 0.4s ease-in-out,
        visibility 0s linear 0s;
    }

    nav ul {
      flex-direction: column;
      gap: 1.5rem;
      padding: 1rem 0;
      align-items: center;
      margin-top: 15px;
      z-index: 2;
    }
  }
</style>
