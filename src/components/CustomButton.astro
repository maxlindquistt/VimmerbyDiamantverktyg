---
/**
 * Outlined link button with a circle-fill hover effect (from Uiverse.io by nikk7007).
 *
 * Renders one `<a class="button">`. The old web component wrapped a `<button>`
 * in an `<a>`, which is invalid HTML. The extra declarations under
 * "button parity" give the link the same metrics the browser's default
 * `<button>` styles produced, so it looks the same.
 */
interface Props {
  text: string
  href: string
  /** Set to "page" on the link for the current page (nav bar). */
  'aria-current'?: 'page' | undefined
}

const { text, href, 'aria-current': ariaCurrent } = Astro.props
---

<a class="button" href={href} aria-current={ariaCurrent}>{text}</a>

<style>
  .button {
    --color: white;
    padding: 0.8em 1.7em;
    background-color: transparent;
    border-radius: 0.3em;
    position: relative;
    overflow: hidden;
    cursor: pointer;
    transition: 0.5s;
    font-weight: 400;
    font-size: 17px;
    border: 1px solid;
    text-transform: uppercase;
    color: var(--color);
    z-index: 1;
    font-family: 'Poppins', sans-serif;

    /* button parity: values the UA stylesheet sets on <button> */
    display: inline-block;
    box-sizing: border-box;
    font-style: normal;
    line-height: normal;
    letter-spacing: normal;
    word-spacing: normal;
    text-align: center;
    text-indent: 0;
    text-shadow: none;
    text-decoration: none;
    /*
     * With overflow: hidden, an inline-block's baseline is its bottom edge,
     * while a <button> keeps its text baseline. That would make the line box a
     * few pixels taller. The button is always alone on its line, so top
     * alignment puts it exactly where baseline alignment put the old <button>.
     */
    vertical-align: top;
  }

  .button::before,
  .button::after {
    content: '';
    display: block;
    width: 50px;
    height: 50px;
    transform: translate(-50%, -50%);
    position: absolute;
    border-radius: 50%;
    z-index: -1;
    background-color: var(--color);
    transition: 0.7s ease;
  }

  .button::before {
    top: -1em;
    left: -1em;
  }

  .button::after {
    left: calc(100% + 1em);
    top: calc(100% + 1em);
  }

  .button:hover::before,
  .button:hover::after {
    height: 410px;
    width: 410px;
  }

  .button:hover {
    color: rgb(10, 25, 30);
  }

  .button:active {
    filter: brightness(0.8);
  }
</style>
