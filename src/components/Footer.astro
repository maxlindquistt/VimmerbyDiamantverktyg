---
interface Props {
  /**
   * Set this on pages whose stylesheet starts with a
   * `* { margin: 0; padding: 0; box-sizing: border-box }` reset. In the old
   * site that reset was global, so it also applied to the footer. Page styles
   * are scoped now, so the footer has to apply the reset itself to look the
   * same. The home page has no reset, so it leaves this off.
   */
  reset?: boolean
}

const { reset = false } = Astro.props
---

<footer class:list={['footer', { 'footer--reset': reset }]}>
  <div class="footer-content">
    <div class="company-info">
      <h2>Vimmerby Diamantverktyg</h2>
      <p>Specialister på diamantverktyg och precision</p>
    </div>

    <div class="contact-info">
      <div class="contact-item">
        <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
        </svg>
        <span class="contact-text">Tegelbruksgatan 7, 598 40 Vimmerby</span>
      </div>

      <div class="contact-item">
        <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
        </svg>
        <a href="tel:+46702297636" class="contact-text">070-2297636</a>
      </div>

      <div class="contact-item">
        <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
        </svg>
        <a href="mailto:christian.linderson@gmail.com" class="contact-text">christian.linderson@gmail.com</a>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; 2025 Vimmerby Diamantverktyg. Alla rättigheter förbehållna.</p>
  </div>
</footer>

<style>
  /* Zero specificity, like the original `*` selector, so every footer rule below still wins. */
  :global(:where(.footer--reset, .footer--reset *)) {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  .footer {
      background: linear-gradient(135deg, #000000 0%, #1f1f1f 100%);
      color: white;
      padding: 20px 0;
      position: relative;
      overflow: hidden;
  }

  .footer::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, #000000, #888888);
  }

  .footer-content {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      align-items: center;
  }

  .company-info h2 {
      margin: 0 0 20px 0;
      font-size: 2rem;
      font-weight: 700;
      background: linear-gradient(45deg, #ffffff, #2d2d2d);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
  }

  .company-info p {
      margin: 0 0 15px 0;
      font-size: 1.1rem;
      line-height: 1.6;
      opacity: 0.9;
  }

  .contact-info {
      display: flex;
      flex-direction: column;
      gap: 15px;
  }

  .contact-item {
      display: flex;
      align-items: center;
      gap: 15px;
      padding: 15px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 10px;
      transition: all 0.3s ease;
      backdrop-filter: blur(10px);
  }

  .contact-item:hover {
      background: rgba(255, 255, 255, 0.15);
      transform: translateX(5px);
  }

  .contact-icon {
      width: 24px;
      height: 24px;
      fill: #3498db;
      flex-shrink: 0;
  }

  .contact-text {
      font-size: 1rem;
      color: white;
      text-decoration: none;
  }

  .contact-text:hover {
      text-decoration: underline;
  }

  .footer-bottom {
      text-align: center;
      margin-top: 30px;
      padding-top: 20px;
      border-top: 1px solid rgba(255, 255, 255, 0.2);
      opacity: 0.8;
  }

  @media (max-width: 768px) {
      .footer-content {
          grid-template-columns: 1fr;
          gap: 30px;
          text-align: center;
      }

      .company-info h2 {
          font-size: 1.5rem;
      }
  }
</style>
