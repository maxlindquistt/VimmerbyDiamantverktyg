---
import BaseLayout from '../../layouts/BaseLayout.astro'
---

<BaseLayout preloadImage="/img/services-bg2.webp" resetFooter>
  <section class="services-section">
    <div class="overlay"></div>
    <div class="services-grid">

      <a href="/services/diamond" class="card1">
        <div class="service-card with-image card1">
          <p class="service-text">Omsättning av borr</p>
        </div>
      </a>

      <a href="/services/warehouse" class="card2">
        <div class="service-card with-image card2">
          <p class="service-text">Hämtlager</p>
        </div>
      </a>

      <a href="https://jlmgroup.se/shop/" target="_blank" class="card3">
        <div class="with-image card3 service-card3">
          <p class="service-text">Samarbetspartner med JLM Group <br> Se hela sortimentet här!</p>
          <img src="/img/JLM_GROUP_red-and-white_long.webp" alt="JLM Group" width="2500" height="693" style="width: 90%; height: auto;" />
        </div>
      </a>

    </div>
  </section>
</BaseLayout>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :global(body) {
    font-family: Arial, sans-serif;
  }

  .services-section {
    padding: 4rem 2rem;
    position: relative;
    min-height: 100vh;
    background-image: url('/img/services-bg2.webp');
    background-size: cover;
    background-position: bottom 70% center;
  }

  .overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    top: 0;
    left: 0;
    z-index: 0;
  }

  .services-grid {
    position: relative;
    display: grid;
    grid-template-areas:
      "card1 card2"
      "card3 card3";
    gap: 2.5rem;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    align-items: center;
    justify-items: center;
  }

  .service-card {
    background: #000;
    border-radius: 1rem;
    padding: 2rem;
    text-align: center;
    font-size: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 200px;
    width: 400px;
    transition: transform 0.3s ease;
  }

  .service-card:hover {
    transform: scale(1.03);
  }

  .with-image {
    background-size: cover;
    background-position: center;
    color: white;
    position: relative;
    overflow: hidden;
  }

  .with-image::before {
    content: "";
    position: absolute;
    inset: 0;
  }

  .with-image .service-text {
    position: relative;
    z-index: 1;
    font-weight: 500;
    font-size: 1.5rem;
  }

  .card1 {
    grid-area: card1;
    background-image: url('/img/Verktyg 2.webp');
    background-color: rgba(0, 0, 0, 0.6);
    background-blend-mode: darken;
    text-decoration: none;
    border-radius: 1rem;
  }

  .card2 {
    grid-area: card2;
    background-image: url('/img/IMG_9792.webp');
    background-color: rgba(0, 0, 0, 0.6);
    background-blend-mode: darken;
    text-decoration: none;
    border-radius: 1rem;
  }

  .card3 {
    grid-area: card3;
    text-decoration: none;
    display: block;
  }

  .card3 p {
    margin-top: -10px;
  }

  .service-card3 {
    background: #000;
    border-radius: 1rem;
    padding: 2rem;
    text-align: center;
    font-size: 1.2rem;
    display: block;
    align-items: center;
    justify-content: center;
    height: 200px;
    width: 400px;
    transition: transform 0.3s ease;
    border: 1px solid white;
  }

  .service-card3:hover {
    transform: scale(1.03);
  }

  .header {
    margin-top: -10px;
  }

  /* Tablet styles */
  @media (max-width: 768px) {
    .card1 {
      background-size: 110%;
    }

    .services-section {
      padding: 3rem 1.5rem;
      background-position: center;
    }

    .services-grid {
      grid-template-areas:
        "card1"
        "card2"
        "card3";
      gap: 2rem;
      max-width: 500px;
    }

    .service-card,
    .service-card3 {
      width: 100%;
      max-width: 400px;
      height: 180px;
      padding: 1.5rem;
    }

    .with-image .service-text {
      font-size: 1.3rem;
    }

    .service-card3 {
      font-size: 1.1rem;
    }
  }

  /* Mobile styles */
  @media (max-width: 480px) {
    .card1 {
      background-size: 120%;
    }

    .services-section {
      padding: 2rem 1rem;
      min-height: auto;
    }

    .services-grid {
      gap: 1.5rem;
      max-width: 100%;
    }

    .service-card,
    .service-card3 {
      width: 100%;
      height: 160px;
      padding: 1rem;
      font-size: 1rem;
    }

    .with-image .service-text {
      font-size: 1.1rem;
      line-height: 1.3;
    }

    .service-card3 {
      font-size: 1rem;
    }

    .service-card3 img {
      width: 85% !important;
      margin-top: 0.5rem;
    }

    .card3 p {
      margin-top: 0;
      margin-bottom: 0.5rem;
    }
  }

  /* Very small mobile styles */
  @media (max-width: 320px) {
    .services-section {
      padding: 1.5rem 0.5rem;
    }

    .services-grid {
      gap: 1rem;
      padding: 0 0.5rem;
    }

    .service-card,
    .service-card3 {
      height: 140px;
      padding: 0.8rem;
    }

    .with-image .service-text {
      font-size: 1rem;
    }

    .service-card3 {
      font-size: 0.9rem;
    }

    .service-card3 img {
      width: 80% !important;
    }
  }

  /* Landscape mobile adjustments */
  @media (max-width: 768px) and (orientation: landscape) {
    .services-section {
      min-height: auto;
      padding: 2rem 1rem;
    }

    .services-grid {
      grid-template-areas:
        "card1 card2"
        "card3 card3";
      max-width: 100%;
    }

    .service-card,
    .service-card3 {
      height: 140px;
    }
  }

  /* Large desktop adjustments */
  @media (min-width: 1400px) {
    .services-grid {
      max-width: 1400px;
      gap: 3rem;
    }

    .service-card,
    .service-card3 {
      width: 450px;
      height: 220px;
    }

    .with-image .service-text {
      font-size: 1.6rem;
    }
  }
</style>
