---
import BaseLayout from '../layouts/BaseLayout.astro'
import { sendContactMail } from '../lib/mailer'

// Rendered on demand (not prerendered) so the form POST can be handled here.
export const prerender = false

if (Astro.request.method === 'POST') {
  try {
    const form = await Astro.request.formData()
    const field = (key: string) => {
      const value = form.get(key)
      return typeof value === 'string' ? value : ''
    }
    // Fire-and-forget: the redirect does not wait for the mail to be delivered.
    sendContactMail({ name: field('name'), email: field('email'), message: field('message') })
  } catch (error) {
    console.log('Could not read the contact form submission:', error)
  }
  return Astro.redirect('/contact', 302)
}
---

<BaseLayout preloadImage="/img/kontakt-bg.webp" resetFooter>
  <section class="kontakt-section">
    <div class="overlay"></div>

    <div class="kontakt-container">

      <div class="info-box">
        <div>
          <h2>Adress</h2>
          <p>Tegelbruksgatan 7<br>598 40 Vimmerby</p>
        </div>
        <div>
          <h2>Telefon</h2>
          <p>070-2297636</p>
        </div>
        <div>
          <h2>E-post</h2>
          <p>christian.linderson@gmail.com</p>
        </div>
      </div>

      <div class="form-box">
        <h1>Kontakta oss</h1>
        <p>Har du frågor om våra produkter eller vill du komma i kontakt med oss?<br>
          Fyll i formuläret nedan eller använd kontaktuppgifterna</p>

        <form action="/contact" method="POST">
          <label for="name">Ditt namn</label>
          <input type="text" id="name" name="name" placeholder="Namn" required>

          <label for="email">Din e-postadress</label>
          <input type="email" id="email" name="email" placeholder="epost@adress.se" required>

          <label for="message">Ditt meddelande</label>
          <textarea id="message" name="message" rows="5" placeholder="Skriv ditt meddelande här..." required></textarea>

          <button type="submit">Skicka</button>
        </form>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .kontakt-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    margin-top: -70px;
    background-image: url('/img/kontakt-bg.webp');
    background-size: cover;
    background-position: center;
  }

  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.6);
    z-index: 1;
  }

  .kontakt-container {
    display: flex;
    gap: 3rem;
    max-width: 1000px;
    width: 100%;
    flex-wrap: wrap;
    justify-content: center;
    margin-left: 7.5rem;
    position: relative;
    z-index: 2;
  }

  .form-box {
    background: rgba(0, 0, 0, 0.5);
    padding: 2rem;
    border: 2px solid #999;
    border-radius: 12px;
    flex: 1;
    min-width: 300px;
    max-width: 600px;
  }

  .form-box h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .form-box p {
    margin-bottom: 2rem;
    font-size: 1rem;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  input,
  textarea {
    padding: 0.8rem;
    border: none;
    border-radius: 10px;
    font-size: 1rem;
    color: black;
    width: 100%;
    resize: none;
  }

  button {
    padding: 0.8rem;
    background: white;
    color: black;
    font-weight: bold;
    border-radius: 10px;
    border: none;
    cursor: pointer;
    margin-top: 1rem;
  }

  .info-box {
    flex: 1;
    min-width: 250px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
  }

  .info-box h2 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .info-box p {
    font-size: 1.2rem;
    line-height: 1.6;
  }

  /* Responsive media queries */
  @media (max-width: 1200px) {
    .kontakt-container {
      margin-left: 2rem;
      margin-right: 2rem;
    }
  }

  @media (max-width: 768px) {
    .kontakt-container {
      flex-direction: column;
      gap: 2rem;
      margin-left: 1rem;
      margin-right: 1rem;
    }

    .form-box h1 {
      font-size: 2rem;
    }

    .info-box h2 {
      font-size: 1.5rem;
    }

    .info-box p {
      font-size: 1rem;
    }
  }

  @media (max-width: 480px) {

    :global(body) {
      overflow: auto;
    }

    .kontakt-section {
      margin-top: 0;
      padding: 1rem 0;
    }

    .kontakt-container {
      margin-left: 0.5rem;
      margin-right: 0.5rem;
      margin-top: 25px;
      gap: 1.5rem;
    }

    .form-box {
      padding: 1.5rem;
      min-width: unset;
      order: -1;
    }

    .form-box h1 {
      font-size: 1.8rem;
    }

    .info-box {
      min-width: unset;
    }

    .info-box h2 {
      font-size: 1.3rem;
      text-align: center;
    }

    .info-box p {
      font-size: 1rem;
      text-align: center;
    }
  }
</style>
